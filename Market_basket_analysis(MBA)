},{"cell_type":"code","source":"# making a function which returns 0 or 1\n# 0 means item was not in that transaction, 1 means item present in that transaction\ndef hot_encode(x): \n    if(x==0): \n        return 0\n    if(x>0): \n        return 1","metadata":{"id":"QgZrv6QX2Sqe","execution":{"iopub.status.busy":"2021-09-08T18:31:03.837498Z","iopub.status.idle":"2021-09-08T18:31:03.838184Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# applying the function to the dataset\nfinal_table=table.applymap(hot_encode)","metadata":{"id":"d3EwIhWk2rK9","execution":{"iopub.status.busy":"2021-09-08T18:31:03.839756Z","iopub.status.idle":"2021-09-08T18:31:03.84042Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"final_table.head()","metadata":{"id":"BM4WJ4id3DJ9","outputId":"c1d0d2ba-3d16-4d02-ce3b-bd8935ba0268","execution":{"iopub.status.busy":"2021-09-08T18:31:03.84174Z","iopub.status.idle":"2021-09-08T18:31:03.842406Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# using the 'apriori algorithm' with min_support=0.01 (1% of 9465)\n# It means the item should be present in atleast 94 transaction out of 9465 transactions only when we considered that item in\n# frequent itemset\nfrequence = apriori(final_table, min_support=0.015, use_colnames=True)\nrules = association_rules(frequence, metric=\"lift\", min_threshold=1)","metadata":{"id":"fnafuzog3fEl","execution":{"iopub.status.busy":"2021-09-08T18:31:03.843748Z","iopub.status.idle":"2021-09-08T18:31:03.844406Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# now making the rules from frequent itemset generated above\nrules.sort_values('confidence', ascending = False, inplace=True)\nrules","metadata":{"id":"gZ5IsXPq3jFh","outputId":"56efb73e-c91c-4c30-ff78-7176653fae4c","execution":{"iopub.status.busy":"2021-09-08T18:31:03.845835Z","iopub.status.idle":"2021-09-08T18:31:03.846496Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# arranging the data from highest to lowest with respect to 'confidence'\n\nrules.sort_values('confidence', ascending=False)","metadata":{"id":"G4myiF7H3nH5","outputId":"6a3167cb-1343-4dca-c065-ad235d4dca56","execution":{"iopub.status.busy":"2021-09-08T18:31:03.847989Z","iopub.status.idle":"2021-09-08T18:31:03.848787Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<h1 style=\"background-color:#FFFFFF;font-size:20px;font-family:Monaco ; font-weight : bold; color : #334257;\">As per the above table we can analyse that coffee is an item that is very associated with other purched items in the bakery, such as toast,medialuana and pastry.</h1>","metadata":{"id":"ifsPxXrp6yi-"}},{"cell_type":"markdown","source":"<h1 style=\"background-color:#FFFFFF;font-size:20px;font-family:Monaco ; font-weight : bold; color : #334257;\">If you find it is helpful,upvote it  👍 \nHope you enjoy!!!   Happy Learning :)\n\nThank you. 😊</h1>","metadata":{"id":"6d2wxbrx7ky-"}}]}